{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "dart",

  "//": "패키지별 독립 버전. 단, separate-pull-requests=false(기본) 로 릴리즈를 한 커밋에 묶어 형제 패키지 태그가 항상 같은 커밋을 가리키게 한다 — 소비 측(kobic)이 형제 패키지를 서로 다른 커밋 조합으로 받는 사고를 구조적으로 차단.",
  "separate-pull-requests": false,
  "include-component-in-tag": true,

  "//bootstrap": "release-please 도입 시점의 main HEAD. 이 이전 히스토리는 첫 릴리즈 노트에 포함하지 않는다.",
  "bootstrap-sha": "f16514f51b4a21eb028f7383921834319950d84d",

  "changelog-sections": [
    { "type": "feat",     "section": "기능" },
    { "type": "fix",      "section": "버그 수정" },
    { "type": "perf",     "section": "성능" },
    { "type": "revert",   "section": "되돌림" },
    { "type": "refactor", "section": "리팩터링" },
    { "type": "docs",     "section": "문서" },
    { "type": "build",    "section": "빌드",   "hidden": true },
    { "type": "ci",       "section": "CI",     "hidden": true },
    { "type": "test",     "section": "테스트", "hidden": true },
    { "type": "style",    "section": "스타일", "hidden": true },
    { "type": "chore",    "section": "기타",   "hidden": true }
  ],

  "packages": {
    "packages/open_epub_engine": { "component": "open_epub_engine" },
    "packages/open_epub": { "component": "open_epub" }
  }
}
